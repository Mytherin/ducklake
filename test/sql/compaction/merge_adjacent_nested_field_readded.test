# name: test/sql/compaction/merge_adjacent_nested_field_readded.test
# description: Files written before a struct field was dropped and re-added under the same name and type are not merged with newer files
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/merge_adjacent_nested_field_readded', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t(s STRUCT(a INTEGER, b INTEGER))

statement ok
INSERT INTO t VALUES ({'a': 1, 'b': 2})

statement ok
INSERT INTO t VALUES ({'a': 3, 'b': 4})

# the struct type is the same again, but s.b is a new field
statement ok
ALTER TABLE t DROP COLUMN s.b

statement ok
ALTER TABLE t ADD COLUMN s.b INTEGER

statement ok
INSERT INTO t VALUES ({'a': 5, 'b': 6})

statement ok
INSERT INTO t VALUES ({'a': 7, 'b': 8})

# the two files of each schema merge separately
query III
SELECT table_name, files_processed, files_created FROM ducklake_merge_adjacent_files('ducklake', 't') ORDER BY ALL
----
t	2	1
t	2	1

query I
SELECT count(*) FROM ducklake_list_files('ducklake', 't')
----
2

# the old values of s.b are not read as the new field
query I
SELECT s FROM t ORDER BY s.a
----
{'a': 1, 'b': NULL}
{'a': 3, 'b': NULL}
{'a': 5, 'b': 6}
{'a': 7, 'b': 8}
