# name: test/sql/autoloading/autoload_sqlite_catalog.test
# description: A SQLite catalog can be attached when the sqlite extension is only loaded by the attach
# group: [autoloading]

require ducklake

require parquet

# builds without the sqlite extension fail the attach, the require below skips the rest of the test for them
statement maybe
ATTACH 'ducklake:sqlite:{TEST_DIR}/{BASE_TEST_NAME}.db' AS ducklake (DATA_PATH '{TEST_DIR}/autoload_sqlite_catalog')
----
sqlite

require sqlite_scanner

statement ok
CREATE TABLE ducklake.t AS SELECT 42 AS i

query I
FROM ducklake.t
----
42

query I
SELECT count(*) FROM duckdb_extensions() WHERE loaded AND extension_name = 'sqlite_scanner'
----
1
