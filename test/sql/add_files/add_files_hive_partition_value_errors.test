# name: test/sql/add_files/add_files_hive_partition_value_errors.test
# description: Hive partition values that cannot be added: a negative bucket and a nested column
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_hive_partition_value_errors')

statement ok
USE ducklake

# bucket numbers are never negative, and 3 is the bucket of i = 3
statement ok
CREATE TABLE bucketed(i INTEGER)

statement ok
ALTER TABLE bucketed SET PARTITIONED BY (bucket(4, i))

statement ok
COPY (SELECT 1 AS i, -1 AS bucket UNION ALL SELECT 3, 3) TO '{DATA_PATH}/add_files_hive_partition_value_errors_bucket' (FORMAT parquet, PARTITION_BY (bucket))

statement error
CALL ducklake_add_data_files('ducklake', 'bucketed', '{DATA_PATH}/add_files_hive_partition_value_errors_bucket/bucket=-1/*.parquet', hive_partitioning => true)
----
contains an invalid partition value for the table configuration

statement ok
CALL ducklake_add_data_files('ducklake', 'bucketed', '{DATA_PATH}/add_files_hive_partition_value_errors_bucket/bucket=3/*.parquet', hive_partitioning => true)

query I
SELECT i FROM bucketed WHERE i = 3
----
3

# a nested column cannot come from a hive partition, not even a NULL one
statement ok
CREATE TABLE nested(i INTEGER, s STRUCT(a INTEGER))

statement ok
COPY (SELECT 1 AS i, NULL::INTEGER AS s) TO '{DATA_PATH}/add_files_hive_partition_value_errors_nested' (FORMAT parquet, PARTITION_BY (s))

statement error
CALL ducklake_add_data_files('ducklake', 'nested', '{DATA_PATH}/add_files_hive_partition_value_errors_nested/*/*.parquet', hive_partitioning => true)
----
is not supported for hive partitioning

query I
SELECT count(*) FROM nested
----
0
