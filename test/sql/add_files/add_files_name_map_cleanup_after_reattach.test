# name: test/sql/add_files/add_files_name_map_cleanup_after_reattach.test
# description: Expiring the snapshots of a dropped table removes its name maps, also when they were never loaded
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_name_map_cleanup', METADATA_CATALOG 'ducklake_meta')

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
COPY (SELECT 42 AS i) TO '{DATA_PATH}/add_files_name_map_cleanup_file.parquet'

statement ok
CALL ducklake_add_data_files('ducklake', 't', '{DATA_PATH}/add_files_name_map_cleanup_file.parquet')

query I
FROM ducklake.t
----
42

query I
SELECT count(*) FROM ducklake_meta.ducklake_name_mapping
----
1

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_name_map_cleanup', METADATA_CATALOG 'ducklake_meta')

statement ok
DROP TABLE ducklake.t

statement ok
CALL ducklake_expire_snapshots('ducklake', older_than => now())

query I
SELECT count(*) FROM ducklake_meta.ducklake_name_mapping
----
0
