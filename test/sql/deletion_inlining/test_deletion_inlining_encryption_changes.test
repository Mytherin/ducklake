# name: test/sql/deletion_inlining/test_deletion_inlining_encryption_changes.test
# description: Change feeds of an encrypted DuckLake report deletions that are inlined in the metadata
# group: [deletion_inlining]

require ducklake

require parquet

require httpfs

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/deletion_inlining_encryption_changes', ENCRYPTED, DATA_INLINING_ROW_LIMIT 5)

statement ok
USE ducklake

# snapshot 1 creates the table, snapshot 2 writes an encrypted data file
statement ok
CREATE TABLE t (i INTEGER);

statement ok
INSERT INTO t SELECT i FROM range(20) r(i);

# snapshot 3: a small delete is inlined in the metadata instead of written as a delete file
statement ok
DELETE FROM t WHERE i < 3;

query I
SELECT COUNT(*) FROM GLOB('{DATA_PATH}/deletion_inlining_encryption_changes/**/*-delete.*')
----
0

query II
SELECT snapshot_id, i FROM ducklake_table_deletions('ducklake', 'main', 't', 3, 3) ORDER BY i
----
3	0
3	1
3	2

query III
SELECT snapshot_id, change_type, i FROM ducklake_table_changes('ducklake', 'main', 't', 2, 3) WHERE change_type = 'delete' ORDER BY i
----
3	delete	0
3	delete	1
3	delete	2

query I
SELECT COUNT(*) FROM t
----
17
