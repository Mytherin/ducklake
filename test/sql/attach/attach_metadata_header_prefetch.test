# name: test/sql/attach/attach_metadata_header_prefetch.test
# description: Reattaching a DuckLake reads the DuckDB metadata header in a single read
# group: [attach]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/header_prefetch.ducklake' AS lake (DATA_PATH '{TEST_DIR}/header_prefetch_files')

statement ok
DETACH lake

statement ok
CALL enable_logging('FileSystem', level => 'trace')

statement ok
ATTACH 'ducklake:{TEST_DIR}/header_prefetch.ducklake' AS lake

query I
SELECT count(*) FROM duckdb_logs_parsed('FileSystem') WHERE path LIKE '%header_prefetch.ducklake' AND op = 'READ' AND pos < 12288
----
1
