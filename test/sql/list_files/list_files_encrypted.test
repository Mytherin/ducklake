# name: test/sql/list_files/list_files_encrypted.test
# description: ducklake_list_files returns the encryption keys of the data and delete files of an encrypted DuckLake
# group: [list_files]

require ducklake

require parquet

require httpfs

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/list_files_encrypted', DATA_INLINING_ROW_LIMIT 0, ENCRYPTED)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (1), (2), (3)

query IIIIII
SELECT data_file IS NOT NULL, data_file_footer_size > 0, octet_length(data_file_encryption_key), delete_file, delete_file_size_bytes, delete_file_encryption_key FROM ducklake_list_files('ducklake', 't')
----
true	true	32	NULL	NULL	NULL

statement ok
DELETE FROM ducklake.t WHERE i = 2

query IIII
SELECT octet_length(data_file_encryption_key), delete_file IS NOT NULL, octet_length(delete_file_encryption_key), data_file_encryption_key = delete_file_encryption_key FROM ducklake_list_files('ducklake', 't')
----
32	true	32	false

query I
SELECT i FROM ducklake.t ORDER BY i
----
1
3
