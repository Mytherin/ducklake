# name: test/sql/metadata/data_file_without_row_id_start.test
# description: Reading the row ids of a data file that has neither a row_id_start nor embedded row ids fails cleanly
# group: [metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/data_file_without_row_id_start', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (id INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
UPDATE meta.ducklake_data_file SET row_id_start = NULL

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/data_file_without_row_id_start', METADATA_CATALOG 'meta')

# the columns themselves can still be read
query I
SELECT id FROM dl.t ORDER BY id
----
1
2

statement error
SELECT rowid, id FROM dl.t
----
does not have row_id_start defined
