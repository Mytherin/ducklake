# name: test/sql/sorted_table/insert_sorted_foreign_dialect.test
# description: Inserts do not sort by sort keys that are written in an SQL dialect other than DuckDB's
# group: [sorted_table]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/insert_sorted_foreign_dialect.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/insert_sorted_foreign_dialect', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t (i INTEGER)

statement ok
ALTER TABLE ducklake.t SET SORTED BY (i DESC)

statement ok
INSERT INTO ducklake.t VALUES (1), (3), (2)

query I
SELECT i FROM ducklake.t ORDER BY rowid
----
3
2
1

# another engine wrote the sort key in its own dialect
statement ok
UPDATE __ducklake_metadata_ducklake.ducklake_sort_expression SET dialect = 'spark'

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/insert_sorted_foreign_dialect', DATA_INLINING_ROW_LIMIT 0)

statement ok
INSERT INTO ducklake.t VALUES (4), (6), (5)

query I
SELECT i FROM ducklake.t ORDER BY rowid
----
3
2
1
4
6
5
