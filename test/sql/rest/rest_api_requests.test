# name: test/sql/rest/rest_api_requests.test
# description: Send requests to the DuckLake REST API directly
# group: [rest]

require json

include test/template/rest_setup.test_template

# a commit request can be sent on its own
query I
SELECT response->>'$.table_ids[0].table_id' FROM ducklake_rest_request('{rest_server}', 'create_table',
'{"schema_path": ["main"], "table_name": "t", "columns": [{"column_name": "i", "column_type": "INTEGER"}, {"column_name": "s", "column_type": "VARCHAR"}]}')
----
1

query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'insert_rows',
'{"table_id": 1, "column_types": [{"id": "INTEGER"}, {"id": "VARCHAR"}], "rows": [[1, "one"], [2, null]], "column_stats": []}')
----
200

# several requests in one transaction, the created table is referred to with a placeholder
query II
SELECT response->>'$.snapshot_id', response->>'$.table_ids[0].placeholder' FROM ducklake_rest_request('{rest_server}', 'commit_transaction',
'{"requests": [
  {"create_table": {"table_id": -1, "schema_path": ["main"], "table_name": "t2", "columns": [{"column_name": "j", "column_type": "BIGINT", "default": "42"}]}},
  {"insert_rows": {"table_id": -1, "column_types": [{"id": "BIGINT"}], "rows": [[100]], "column_stats": []}}
]}')
----
3	-1

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl

query II
FROM dl.t ORDER BY i
----
1	one
2	NULL

query I
FROM dl.t2
----
100

# the scan plan returns the inlined rows of the table
query III
SELECT status, json_array_length(response->'$.inlined_data[0].rows'), response->>'$.inlined_data[0].columns[3].name'
FROM ducklake_rest_request('{rest_server}', 'select', '{"table_id": 1, "include_inlined_data": true}')
----
200	2	i

query I
SELECT (response->'$.inlined_data') IS NULL FROM ducklake_rest_request('{rest_server}', 'select', '{"table_id": 1}')
----
true

query I
SELECT response->>'$.snapshot.snapshot_id' FROM ducklake_rest_request('{rest_server}', 'snapshot_data', '{}')
----
3

query I
SELECT json_array_length(response->'$.rows') FROM ducklake_rest_request('{rest_server}', 'ducklake_table', '{"table_name": "ducklake_snapshot"}')
----
4

# a created entry is returned with its id under the reference of its request
query II
SELECT response->>'$.entry_ids[0].entry_reference', response->>'$.entry_ids[0].type'
FROM ducklake_rest_request('{rest_server}', 'create_schema', '{"schema_path": ["s"], "entry_reference": 1234}')
----
1234	SCHEMA_ENTRY

# errors
query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'unknown_endpoint', '{}')
----
400	Invalid Input

query II
SELECT status, response->>'$.error.type' FROM ducklake_rest_request('{rest_server}', 'select', '{"table_id": 1000}')
----
404	Catalog

query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'create_table',
'{"schema_path": ["main"], "table_name": "t", "columns": [{"column_name": "i", "column_type": "INTEGER"}]}')
----
404

# inlined data is identified by the table and the schema version
query I
SELECT response->>'$.schema_versions' FROM ducklake_rest_request('{rest_server}', 'inlined_tables', '{"table_id": 1}')
----
[1]

# the inlined rows that changed come with the change feed
query II
SELECT json_array_length(response->'$.inlined_data[0].rows'), response->>'$.inlined_data[0].schema_version'
FROM ducklake_rest_request('{rest_server}', 'table_changes',
'{"table_id": 1, "start_snapshot_id": 0, "changes": "insertions", "include_inlined_data": true}')
----
2	1

query I
SELECT json_array_length(response->'$.inlined_data[0].rows') FROM ducklake_rest_request('{rest_server}', 'table_changes',
'{"table_id": 1, "start_snapshot_id": 0, "changes": "deletions", "include_inlined_data": true}')
----
0

query I
SELECT (response->'$.inlined_data') IS NULL FROM ducklake_rest_request('{rest_server}', 'table_changes',
'{"table_id": 1, "start_snapshot_id": 0, "changes": "insertions"}')
----
true

# the inlined rows that a flush writes
query II
SELECT json_array_length(response->'$.rows'), response->>'$.columns[0].type.id' FROM ducklake_rest_request('{rest_server}', 'inlined_data_for_flush',
'{"table_id": 1, "schema_version": 1, "columns": ["i"]}')
----
2	INTEGER

query I
SELECT response->>'$.row_count' FROM ducklake_rest_request('{rest_server}', 'row_count',
'{"table_id": 1, "schema_version": 1, "count": "inlined"}')
----
2

query I
SELECT response->>'$.inlined_data[0].schema_version' FROM ducklake_rest_request('{rest_server}', 'select', '{"table_id": 1, "include_inlined_data": true}')
----
1

# the schema version has to have inlined data
query II
SELECT status, response->>'$.error.message' LIKE '%has no inlined data for schema version 7%' FROM ducklake_rest_request('{rest_server}', 'inlined_data_for_flush',
'{"table_id": 1, "schema_version": 7, "columns": ["i"]}')
----
404	true

query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'row_count', '{"table_id": 1, "count": "inlined"}')
----
400

# the columns to read cannot inject SQL into the queries of the server
query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'inlined_data_for_flush',
'{"table_id": 1, "schema_version": 1, "columns": ["(SELECT 42)"]}')
----
400

# requests are validated against the specification of the API
query II
SELECT status, response->>'$.error.message' LIKE '%not a valid TableChangeType%' FROM ducklake_rest_request('{rest_server}', 'table_changes',
'{"table_id": 1, "start_snapshot_id": 0, "changes": "everything"}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%missing required field "table_id"%' FROM ducklake_rest_request('{rest_server}', 'select', '{}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%expected a JSON integer%' FROM ducklake_rest_request('{rest_server}', 'select', '{"table_id": "one"}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%Unsupported request "create_everything"%' FROM ducklake_rest_request('{rest_server}', 'commit_transaction',
'{"requests": [{"create_everything": {}}]}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%exactly one member%' FROM ducklake_rest_request('{rest_server}', 'commit_transaction',
'{"requests": [{"create_schema": {"schema_path": ["s2"]}, "drop_schema": {"schema_path": ["s2"]}}]}')
----
400	true

# alterations are unions: an object with exactly one member, the name of the change
query I
SELECT status FROM ducklake_rest_request('{rest_server}', 'alter_table',
'{"schema_path": ["main"], "name": "t", "alter": {"rename_column": {"old_name": "s", "new_name": "str"}}}')
----
200

query I
SELECT string_agg(column_name, ',' ORDER BY column_name) FROM (DESCRIBE dl.t)
----
i,str

query II
SELECT status, response->>'$.error.message' LIKE '%"bogus" is not a valid Alteration%' FROM ducklake_rest_request('{rest_server}', 'alter_table',
'{"name": "t", "alter": {"bogus": {}}}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%exactly one%' FROM ducklake_rest_request('{rest_server}', 'alter_table',
'{"name": "t", "alter": {"type": "rename_column", "old_name": "i", "new_name": "j"}}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%missing required field "new_name"%' FROM ducklake_rest_request('{rest_server}', 'alter_table',
'{"name": "t", "alter": {"rename_table": {}}}')
----
400	true

query II
SELECT status, response->>'$.error.message' LIKE '%not a valid CatalogEntryType%' FROM ducklake_rest_request('{rest_server}', 'alter_table',
'{"name": "t", "alter": {"set_comment": {"entry_type": "SCHEMA_ENTRY", "comment": "c"}}}')
----
400	true

# the changes of a table are returned by their type
query II
SELECT status, json_array_length(response->'$.insertions') > 0 FROM ducklake_rest_request('{rest_server}', 'table_changes',
'{"table_id": 1, "start_snapshot_id": 0, "changes": "insertions"}')
----
200	false

statement ok
DETACH dl

include test/template/rest_teardown.test_template
