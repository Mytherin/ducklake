# name: test/sql/delete/transaction_local_delete_files.test
# description: Delete files written in a transaction, on some of the files of a table or on its new files
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/transaction_local_delete_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t SELECT range FROM range(100)

statement ok
INSERT INTO ducklake.t SELECT range FROM range(100, 200)

# only the first file gets a delete file in this transaction
statement ok
BEGIN

statement ok
DELETE FROM ducklake.t WHERE i < 50

query II
SELECT count(*), sum(i) FROM ducklake.t
----
150	18675

statement ok
COMMIT

# a new file loses its rows in two deletes: the file and its delete file are removed
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t SELECT range FROM range(1000, 1020)

statement ok
DELETE FROM ducklake.t WHERE i >= 1000 AND i < 1010

query II
SELECT count(*), sum(i) FROM ducklake.t WHERE i >= 1000
----
10	10145

statement ok
DELETE FROM ducklake.t WHERE i >= 1010

query II
SELECT count(*), sum(i) FROM ducklake.t
----
150	18675

statement ok
COMMIT

query II
SELECT count(*), sum(i) FROM ducklake.t
----
150	18675

query II
SELECT count(*), count(*) FILTER (WHERE file LIKE '%-delete.%')
FROM glob('{DATA_PATH}/transaction_local_delete_files/main/t/*')
----
3	1
