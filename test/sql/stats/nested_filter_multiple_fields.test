# name: test/sql/stats/nested_filter_multiple_fields.test
# description: Filters that read several fields of a struct, or a struct that is not a column, are not checked against field stats
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/nested_filter_multiple_fields', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t (i INTEGER, s STRUCT(a INTEGER, b INTEGER), s2 STRUCT(a INTEGER, b INTEGER));

statement ok
INSERT INTO t SELECT i, {'a': i, 'b': i + 1}, {'a': -i, 'b': i} FROM range(1, 101) r(i);

statement ok
INSERT INTO t SELECT i, {'a': i, 'b': i + 1}, {'a': -i, 'b': i} FROM range(101, 201) r(i);

# one filter over two fields has no single field to prune on
query I
SELECT i FROM t WHERE CAST(s.a AS VARCHAR) || CAST(s.b AS VARCHAR) = '56'
----
5

query II
EXPLAIN ANALYZE SELECT i FROM t WHERE CAST(s.a AS VARCHAR) || CAST(s.b AS VARCHAR) = '56'
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# and neither do several such filters on the same column
query I
SELECT i FROM t WHERE CAST(s.a AS VARCHAR) || CAST(s.b AS VARCHAR) = '56' AND CAST(s.b AS VARCHAR) || CAST(s.a AS VARCHAR) = '65'
----
5

query II
EXPLAIN ANALYZE SELECT i FROM t WHERE CAST(s.a AS VARCHAR) || CAST(s.b AS VARCHAR) = '56' AND CAST(s.b AS VARCHAR) || CAST(s.a AS VARCHAR) = '65'
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*

# a field of a computed struct belongs to no column, so the disjunction prunes nothing
query I
SELECT i FROM t WHERE if(i > 50, s, s2).a = 150 OR i = 20 ORDER BY i
----
20
150

query II
EXPLAIN ANALYZE SELECT i FROM t WHERE if(i > 50, s, s2).a = 150 OR i = 20
----
analyzed_plan	<REGEX>:.*Total Files Read: 2.*
