# name: test/sql/stats/or_filter_volatile_branch.test
# description: A disjunction with a volatile branch that calls a function without arguments returns the right rows
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/or_filter_volatile_branch', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
INSERT INTO ducklake.t VALUES (2)

statement ok
INSERT INTO ducklake.t VALUES (3)

query I
SELECT i FROM ducklake.t WHERE random() < 2 OR i = 2 ORDER BY i
----
1
2
3

query I
SELECT i FROM ducklake.t WHERE random() < 0 OR i = 2 ORDER BY i
----
2
