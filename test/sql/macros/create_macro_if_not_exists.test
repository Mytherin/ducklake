# name: test/sql/macros/create_macro_if_not_exists.test
# description: CREATE MACRO IF NOT EXISTS keeps the existing macro
# group: [macros]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/create_macro_if_not_exists')

statement ok
CREATE MACRO ducklake.answer() AS 42

statement ok
CREATE MACRO IF NOT EXISTS ducklake.answer() AS 43

statement ok
CREATE MACRO IF NOT EXISTS ducklake.numbers() AS TABLE SELECT 1 AS n

statement ok
CREATE MACRO IF NOT EXISTS ducklake.numbers() AS TABLE SELECT 2 AS n

query I
SELECT ducklake.answer()
----
42

query I
FROM ducklake.numbers()
----
1

statement error
CREATE MACRO ducklake.answer() AS 44
----
already exists
