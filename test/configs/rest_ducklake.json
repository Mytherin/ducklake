{
  "description": "Run DuckLake tests with every DuckLake served by a DuckLake REST server that the test starts.",
  "on_init": "SELECT * FROM ducklake_rest_serve('ducklake:{TEST_DIR}/{BASE_TEST_NAME}__ducklake.db', port := 19878, attach_options := 'DATA_PATH ''{TEST_DIR}/{BASE_TEST_NAME}__ducklake.db.files''');",
  "autoloading": "none",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "ducklake",
    "icu",
    "httpfs"
  ],
  "test_env": [
    {
      "env_name": "DUCKLAKE_CONNECTION",
      "env_value": "rest:http://localhost:19878"
    }
  ],
  "skip_tests": [
    {
      "reason": "Tests the migration of metadata that the test writes to the metadata catalog directly",
      "paths": [
        "test/sql/migration/stale_version_after_migration.test",
        "test/sql/migration/v01_partitioned.test"
      ]
    },
    {
      "reason": "Inspects the SQL queries that are issued to the metadata catalog, which are issued by the REST server",
      "paths": [
        "test/sql/issues/issue_1146_column_insert_batches.test",
        "test/sql/issues/issue_1398_bulk_table_stats.test",
        "test/sql/metadata/metadata_query_budget.test",
        "test/sql/stats/topn_file_pruning.test",
        "test/sql/transaction/transaction_conflicts_inlined_file_deletes.test"
      ]
    },
    {
      "reason": "Snapshots that are expired in a transaction are expired when the transaction commits",
      "paths": [
        "test/sql/transaction/expire_cleanup_same_transaction.test"
      ]
    },
    {
      "reason": "Depends on the location of the metadata database",
      "paths": [
        "test/sql/general/default_path.test",
        "test/sql/general/metadata_parameters.test",
        "test/sql/general/missing_parquet.test",
        "test/sql/remove_orphans/metadata_in_data_path.test",
        "test/sql/issues/issue_1332.test"
      ]
    },
    {
      "reason": "The served DuckLake is attached to the same database, so its tables show up in suggestions for misspelled names",
      "paths": [
        "test/sql/add_files/add_file_specific_schema.test",
        "test/sql/compaction/merge_adjacent_options.test"
      ]
    },
    {
      "reason": "The served DuckLake adds to the object cache of the database",
      "paths": [
        "test/sql/issues/issue_852_cache_growth.test"
      ]
    },
    {
      "reason": "Depends on the timing of concurrent commits",
      "paths": [
        "test/sql/retry/commit_failure.test"
      ]
    },
